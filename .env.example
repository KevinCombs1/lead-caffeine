# ── Lead Caffeine Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values.
# On Render, set these in the dashboard or via render.yaml.

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
BIDDER_DOMAIN=https://leadcaffeine.com
SESSION_SECRET=generate-a-random-string-here

# ── Database (PostgreSQL 18 with PostGIS 3.7) ────────────────────────────
# Use Supabase (has PostGIS built in) or a custom Docker PG+PostGIS container.
DATABASE_URL=postgresql://leadcaffeine:changeme@localhost:5432/leadcaffeine

# ── Auth ─────────────────────────────────────────────────────────────────
SCANNER_PASSWORD=LightEngine

# ── Supreme Line 1 Scraper ───────────────────────────────────────────────
SERPER_API_KEY=your-serper-api-key-here

# ── Redis (MAID dedup + audience sets + target_maids) ────────────────────
REDIS_URL=redis://localhost:6379

# ── ClickHouse (historical analytics + bid win logging) ──────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=geofence123

# ── FlareSolverr (Cloudflare bypass for Supreme Line 2 geocoding) ─────────
FLARESOLVERR_URL=http://localhost:8191
